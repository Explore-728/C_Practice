#include <stdio.h>
#include <limits.h>
#include <stdlib.h>

void print_binary (unsigned long long n);

int main()
{
    int i;
    scanf("%d",i);
    print_binary(i);
    printf("%d",i);

    system("pause");

    return 0;
}

void print_binary (unsigned long long n)
{
    int i;
    int bits = sizeof(n) * CHAR_BIT;
    for(i=bits-1;i>=0;i--){
        printf("%d",(i>>i) & 1);
    }
    printf("\n");
}